# String de conexão do Neon (Postgres) — use a "pooled connection" para DATABASE_URL
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/chamados?sslmode=require"
# Use a "direct connection" (sem -pooler) para DIRECT_URL — necessária para migrations
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/chamados?sslmode=require"

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório grande em produção
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-grande"
JWT_EXPIRES_IN="7d"

# Porta do servidor
PORT=3333

# Origem permitida para CORS (URL do frontend em produção)
CORS_ORIGIN="http://localhost:5173"

# Dados do usuário administrador criado pelo script de seed
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="mude-esta-senha"
