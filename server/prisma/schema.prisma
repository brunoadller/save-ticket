// Schema Prisma — Sistema de Gestão de Chamados dos Polos
// Banco: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MEMBRO
}

enum Polo {
  PELOTAS_I
  PELOTAS_II
  PELOTAS_III
}

enum StudentStatus {
  ATIVO
  FORMANDO
  CONCLUIDO
  DESISTENTE
  SEM_MATRICULA
}

enum TicketStatus {
  ANDAMENTO
  CONCLUIDO
  EXPIRADO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBRO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets         Ticket[] @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")
  tasks           Task[]

  @@map("users")
}

model Ticket {
  id             String       @id @default(uuid())
  protocolo      String
  polo           Polo
  nomeAluno      String
  cpf            String
  ra             String       @default("")
  curso          String       @default("")
  situacaoAtual  StudentStatus?
  // Texto livre antigo, preservado como estava antes do enum (somente leitura)
  situacaoAtualLegado String   @default("")
  telefone       String       @default("")
  justificativa  String       @default("") @db.Text
  status         TicketStatus @default(ANDAMENTO)
  dataCriacao    DateTime     @default(now())
  dataPrazo      DateTime
  dataConclusao  DateTime?

  createdBy      User         @relation("TicketCreator", fields: [userId], references: [id])
  userId         String

  assignedTo     User?        @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId   String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@map("tickets")
}

// Cursos do select de chamados. O chamado guarda o nome como texto (Ticket.curso).
model Course {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

// Tarefas do calendário (compartilhadas pela equipe). "data" é só o dia (sem horário).
model Task {
  id          String    @id @default(uuid())
  titulo      String
  descricao   String    @default("") @db.Text
  data        DateTime  @db.Date
  concluida   Boolean   @default(false)
  concluidaEm DateTime?

  createdBy   User      @relation(fields: [userId], references: [id])
  userId      String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([data])
  @@index([userId])
  @@map("tasks")
}
